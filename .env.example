# =========================================================================
#  VpsHosting - environment template
#  Copy to `.env` and fill in real values.  `.env` is git-ignored.
#  Generate a secret:  python -c "import secrets; print(secrets.token_hex(32))"
# =========================================================================

# Which config class to load: development | testing | production
FLASK_CONFIG=development

# REQUIRED in production. Signs session cookies and CSRF tokens.
SECRET_KEY=

# --- Database ------------------------------------------------------------
# Leave blank to use the dev SQLite file at instance/vpshosting.db.
# PostgreSQL example (scheme is normalised to postgresql+psycopg automatically):
#   DATABASE_URL=postgresql://vpshosting:password@localhost:5432/vpshosting
DATABASE_URL=

# Log every SQL statement (noisy; development only)
SQLALCHEMY_ECHO=false

# --- Session & cookies ---------------------------------------------------
# MUST be true in production (requires HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=7
REMEMBER_COOKIE_DAYS=30

# --- Password policy -----------------------------------------------------
# Werkzeug hashing method. scrypt is the Werkzeug 3 default.
PASSWORD_HASH_METHOD=scrypt:32768:8:1
MIN_PASSWORD_LENGTH=10

# --- Rate limiting -------------------------------------------------------
RATELIMIT_ENABLED=true
# Use redis://localhost:6379/0 in production; memory:// is per-process only.
RATELIMIT_STORAGE_URI=memory://
AUTH_RATELIMIT_LOGIN=10 per 5 minutes
AUTH_RATELIMIT_REGISTER=5 per hour

# --- New account defaults ------------------------------------------------
SIGNUP_BONUS_CREDITS=0

# --- Pterodactyl panel (wired up in a later phase) -----------------------
PTERODACTYL_URL=
PTERODACTYL_API_KEY=
